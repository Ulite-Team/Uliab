package ulite:ulb;

/// The `ulb-plugin` world as it was before the `configure` entry point
/// and the `task-registrar` import were added: a component exports only
/// `manifest` and `run`. This is a frozen snapshot of the ABI at
/// `0.1`; the host keeps a binding to it so a component rebuilt against
/// this legacy world still loads and runs after the ABI grows (the full
/// world in `plugin.wit` requires the `configure` export, which a
/// legacy-world component does not have). New components export the
/// extra entry point, which a legacy-world instantiation simply ignores.
///
/// Instantiation through this snapshot is subject to the host's usual
/// ABI gate: `manifest` must report an abi-version equal to the host's,
/// so a genuine unmodified `0.1` component is refused even though it can
/// be bound here.
///
/// The `plugin-manifest` record below tracks the current shape in
/// `plugin.wit` (including the `tools` field): the host reads a new
/// component's `manifest` through this world, so the record layouts must
/// agree even though the world stops at `manifest`/`run`.
interface ulb-plugin {
    record plugin-manifest {
        name: string,
        version: string,
        abi-version: string,
        tools: list<string>,
        dependencies: list<string>,
    }
    manifest: func() -> plugin-manifest;
    run: func(input: string) -> string;
}

world plugin {
    export ulb-plugin;
}
